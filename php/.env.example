# Fiyatavı (PHP sürümü) ayarları. Bu dosyayı ".env" adıyla kaydet ve doldur. .env hiçbir zaman GitHub'a yüklenmez.

# https://isthereanydeal.com/apps/my/ adresinden ücretsiz alınır
ITAD_API_KEY=
# İsteğe bağlı: Steam'deki tüm oyunlar için (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
# Anahtar sayfasındaki "per 5 minute window" sayısı (e-postanı doğrulayınca artar)
ITAD_RATE_LIMIT=

# Sitenin adresi (maillerdeki link ve paylaşım önizlemesi için), sonunda / olmadan
SITE_URL=https://siteadi.example
# Canlıda production yaz (HTTPS çerezi ve güvenlik başlıkları için)
NODE_ENV=production

# Sitede kaç popüler oyun olsun (en fazla 1000)
CATALOG_SIZE=1000
# Az bakılan oyunların fiyatı kaç saatte bir güncellensin
TAIL_REFRESH_HOURS=24
# Popüler oyunların fiyatları kaç dakikada bir güncellensin
SYNC_MINUTES=60

# Mail gönderimi (boş bırakırsan mailler sadece data/mail.log dosyasına yazılır)
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=adresin@gmail.com  SMTP_PASS=uygulama-sifren
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Site adı ve Yardım sayfasındaki iletişim bilgileri
SITE_NAME=Fiyatavı
SUPPORT_EMAIL=
SUPPORT_INSTAGRAM=
# KVKK metinlerindeki veri sorumlusunun adı soyadı / unvanı
CONTROLLER_NAME=

# Sitede hiç gösterilmesin istediğin mağazalar, virgülle
SHOPS_HIDE=
# Yönetim sekmesini görebilecek e-posta adresleri, virgülle (boşsa SUPPORT_EMAIL)
ADMIN_EMAILS=

# ---- Sadece PHP sürümüne özel ----
# Arka plan işleri (fiyat güncelleme, mail) için:
# 1) cron.php'yi zamanla (önerilen): sunucu cron'u ya da cron-job.org gibi ücretsiz bir servisle
#    https://siteadi.example/cron.php?key=BURAYA_UZUN_BIR_SIFRE  adresini 10 dakikada bir çağır
CRON_KEY=
# 2) Cron yoksa site, ziyaretçi geldikçe kendisi çalışır (tembel tur). Cron kurduysan 0 yap.
LAZY_TICK=1
# Tembel turlar arası dakika ve bir turun azami süresi (saniye; barındırmanın süre sınırının altında kalsın)
TICK_MINUTES=10
TICK_BUDGET=25
# Veri tabanı ve yedekler (varsayılan: data/ klasörü; web'den erişime kapalıdır)
# DB_PATH=
# DATA_DIR=
# Cloudflare gibi bir aracının arkasındaysan 1 yap (ziyaretçinin gerçek adresi için)
TRUST_PROXY=
